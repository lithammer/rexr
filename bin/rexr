#!/bin/sh
# rexr: review a diff or pull request in a clean Neovim, beside an agent in Rex.
set -eu

root=$(dirname "$(dirname "$(readlink -f "$0")")")

# The agent pane and its reviewer meet at a socket named after the agent's
# block, so `rexr reply` run from the agent's pane finds its own reviewer.
sock_for() {
	printf '%s/rexr/%s.sock' "${XDG_RUNTIME_DIR:-${TMPDIR:-/tmp}}" "${1#block:}"
}

usage() {
	cat <<EOF
usage: rexr [diff [BASE] | pr [N]]  review here (default: this branch's PR, else diff)
       rexr open [ARGS...]          review in a Rex split beside this pane's agent
       rexr show ID...              print review comments with their code and threads
       rexr reply ID TEXT           answer review comment ID
show and reply run from the agent's pane and reach the reviewer beside it.
EOF
}

# Set sock to the reviewer beside this pane, or exit.
reviewer_sock() {
	: "${REX_BLOCK:?rexr $1 must run inside the agent's Rex pane}"
	sock=$(sock_for "$REX_BLOCK")
	[ -S "$sock" ] || {
		echo "rexr: no reviewer is open beside this pane" >&2
		exit 1
	}
}

# Evaluate $1 in the reviewer. Neovim holds RPC while a command waits for
# one more key, as f, t, r or m do, so give up after a few seconds rather
# than stall the agent. On a timeout the output, which then holds only the
# killed client's notice, is dropped.
ask() {
	command -v timeout >/dev/null || {
		nvim --server "$sock" --remote-expr "$1"
		return
	}
	status=0
	out=$( (timeout 5 nvim --server "$sock" --remote-expr "$1") 2>&1) || status=$?
	if [ "$status" -eq 124 ]; then
		echo "rexr: the reviewer didn't answer; it may be waiting for a key: press Esc in it" >&2
		return 1
	fi
	printf '%s\n' "$out"
	return "$status"
}

case "${1:-}" in
-h | --help)
	usage
	;;
open)
	shift
	: "${REX_BLOCK:?rexr open must run inside a Rex pane}"
	exec rex split -b "$REX_BLOCK" --split=right --ratio 55 -c "$PWD" -- \
		env REXR_AGENT="$REX_BLOCK" "$root/bin/rexr" "$@"
	;;
show)
	shift
	[ $# -gt 0 ] || {
		usage >&2
		exit 2
	}
	# IDs go into the remote expression below, so take only c<n> and g<n>.
	for id in "$@"; do
		case "$id" in
		[cg]*[!0-9]* | [!cg]* | [cg]) echo "rexr: bad comment ID $id" >&2 && exit 2 ;;
		esac
	done
	reviewer_sock show
	ask "v:lua.require'rexr'.show('$*')"
	;;
reply)
	[ $# -eq 3 ] || {
		usage >&2
		exit 2
	}
	reviewer_sock reply
	msg=$(mktemp)
	trap 'rm -f "$msg"' EXIT
	printf '%s\n%s' "$2" "$3" >"$msg"
	result=$(ask "v:lua.require'rexr'.reply_file('$msg')")
	echo "$result"
	[ "$result" = ok ]
	;;
*)
	args="$*"
	set --
	if [ -n "${REXR_AGENT:-}" ]; then
		sock=$(sock_for "$REXR_AGENT")
		mkdir -p "$(dirname "$sock")"
		rm -f "$sock"
		set -- --listen "$sock"
	fi
	exec nvim --clean --cmd "set rtp^=$root" "$@" +"Rexr $args"
	;;
esac
